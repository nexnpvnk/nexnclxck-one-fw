{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Configure",
            "type": "process",
            "command": "cmake",
            "args": [
                "--preset",
                "${command:cmake.activeConfigurePresetName}"
            ],
            "problemMatcher": [],
            "options": {
                "statusbar": {
                    "hide": true
                }
            }
        },
        {
            "label": "Build",
            "type": "process",
            "command": "cmake",
            "args": [
                "--build",
                "--preset",
                "${command:cmake.activeBuildPresetName}"
            ],
            "dependsOn": [
                "Configure"
            ],
            "problemMatcher": {
                "owner": "gcc",
                "fileLocation": "absolute",
                "pattern": {
                    "regexp": "^(.+?):(\\d+):(\\d+):\\s+(warning|error|fatal error|note):\\s+(.*)$",
                    "file": 1,
                    "line": 2,
                    "column": 3,
                    "severity": 4,
                    "message": 5
                }
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "options": {
                "statusbar": {
                    "hide": true,
                    "label": "$(tools) Build",
                    "detail": "Build active CMake preset"
                }
            }
        },
        {
            "label": "Clean",
            "type": "process",
            "command": "cmake",
            "args": [
                "--build",
                "--preset",
                "${command:cmake.activeBuildPresetName}",
                "--target",
                "clean"
            ],
            "dependsOn": [
                "Configure"
            ],
            "problemMatcher": [],
            "options": {
                "statusbar": {
                    "hide": true
                }
            }
        },
        {
            "label": "Full Clean: Build Directory",
            "type": "process",
            "command": "cmake",
            "args": [
                "-E",
                "rm",
                "-rf",
                "${command:cmake.buildDirectory}"
            ],
            "problemMatcher": [],
            "options": {
                "statusbar": {
                    "hide": true
                }
            }
        },
        {
            "label": "Full Clean: Compile Commands",
            "type": "process",
            "command": "cmake",
            "args": [
                "-E",
                "rm",
                "-f",
                "${workspaceFolder}/compile_commands.json"
            ],
            "problemMatcher": [],
            "options": {
                "statusbar": {
                    "hide": true
                }
            }
        },
        {
            "label": "Full Clean",
            "dependsOrder": "sequence",
            "dependsOn": [
                "Full Clean: Build Directory",
                "Full Clean: Compile Commands"
            ],
            "problemMatcher": [],
            "options": {
                "statusbar": {
                    "label": "$(trash) Full Clean",
                    "detail": "Delete active CMake build directory and configuration"
                }
            }
        },
        {
            "label": "Reconfigure",
            "dependsOrder": "sequence",
            "dependsOn": [
                "Full Clean",
                "Configure"
            ],
            "problemMatcher": [],
            "options": {
                "statusbar": {
                    "hide": true
                }
            }
        },
        {
            "label": "Flash",
            "type": "process",
            "command": "cmake",
            "args": [
                "--build",
                "--preset",
                "${command:cmake.activeBuildPresetName}",
                "--target",
                "flash"
            ],
            "dependsOn": [
                "Build"
            ],
            "problemMatcher": [],
            "options": {
                "statusbar": {
                    "label": "$(cloud-upload) Flash",
                    "detail": "Build, verify and flash firmware"
                }
            }
        },
        {
            "label": "Erase",
            "type": "process",
            "command": "cmake",
            "args": [
                "--build",
                "--preset",
                "${command:cmake.activeBuildPresetName}",
                "--target",
                "erase"
            ],
            "dependsOn": [
                "Configure"
            ],
            "problemMatcher": [],
            "options": {
                "statusbar": {
                    "label": "$(flame) Erase",
                    "detail": "Erase MCU flash"
                }
            }
        },
        {
            "label": "Reset",
            "type": "process",
            "command": "cmake",
            "args": [
                "--build",
                "--preset",
                "${command:cmake.activeBuildPresetName}",
                "--target",
                "reset"
            ],
            "dependsOn": [
                "Configure"
            ],
            "problemMatcher": [],
            "options": {
                "statusbar": {
                    "label": "$(debug-restart) Reset",
                    "detail": "Reset target"
                }
            }
        }
    ]
}
